# Public Supabase settings. Publishable key is safe for the browser when server-side Auth is enabled;
# never place a Supabase service_role/secret key in a VITE_ variable.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Leave false until schema, Edge Function, first ADMIN app_users profile, and live endpoint tests pass.
VITE_EYEKART_LIVE_MODE="false"

# Optional alternate API base for a separately hosted API; unused for the Supabase Edge Function.
VITE_API_BASE_URL=""

# Local Express dev server port (Vercel/Supabase assign their own ports).
PORT=3000
